{
  "$schema": "../node_modules/@tauri-apps/cli/config.schema.json",
  "productName": "Garudabot",
  "version": "0.2.5",
  "identifier": "com.garudabot.garudabot",
  "build": {
    "frontendDist": "../build",
    "devUrl": "http://localhost:8601",
    "beforeDevCommand": "npm start",
    "beforeBuildCommand": "npm run build"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "title": "Garudabot",
        "width": 1280,
        "height": 720,
        "resizable": true,
        "fullscreen": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "externalBin": [
        "bin/arduino-cli"
    ],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "windows": {
      "wix": {
		"fragmentPaths": ["./wix/board-dependencies.wxs"],
		"componentRefs": [
		  "BoardDependenciesInstaller"
		]
      }
    }
  }
}
