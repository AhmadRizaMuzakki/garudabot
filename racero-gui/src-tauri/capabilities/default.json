{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "enables the default permissions",
  "windows": [
    "main"
  ],
  "permissions": [
    "core:default",
    "shell:default",
    "dialog:default",
    "fs:default",
    "fs:allow-read-text-file",
    "fs:allow-write-text-file",
    "fs:allow-read-file",
    "fs:allow-write-file",
    {
      "identifier": "shell:allow-execute",
      "allow": [
        {
          "args": [
            "compile",
            "--upload",
            "--fqbn",
            { "validator": "\\S+" },
            "--port",
            { "validator": "\\S+" },
            { "validator": ".*" }
          ],
          "name": "bin/arduino-cli",
          "sidecar": true
        }
      ]
    },
    "dialog:default"
  ]
}
