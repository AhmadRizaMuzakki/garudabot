{
  "name": "racero-vm",
  "version": "3.0.0",
  "description": "Virtual Machine for Racero Scratch",
  "author": "Racer Robotic Indonesia",
  "license": "BSD-3-Clause",
  "homepage": "https://github.com/scratchfoundation/racero-vm#readme",
  "repository": {
    "type": "git",
    "url": "https://github.com/scratchfoundation/racero-vm.git",
    "sha": "bc6f4199020cb38021fe649065a6b807fcd3c23f"
  },
  "main": "./dist/node/racero-vm.js",
  "browser": "./src/index.js",
  "scripts": {
    "build": "npm run docs && webpack --progress",
    "coverage": "tap ./test/{unit,integration}/*.js --coverage --coverage-report=lcov",
    "docs": "jsdoc -c .jsdoc.json",
    "i18n:src": "mkdirp translations/core && format-message extract --out-file translations/core/en.json src/extensions/**/index.js",
    "i18n:push": "tx-push-src scratch-editor extensions translations/core/en.json",
    "lint": "eslint . && format-message lint src/**/*.js",
    "prepublish": "in-publish && npm run build || not-in-publish",
    "start": "webpack serve",
    "tap": "tap ./test/{unit,integration}/*.js",
    "tap:unit": "tap ./test/unit/*.js",
    "tap:integration": "tap ./test/integration/*.js",
    "test": "npm run lint && npm run tap",
    "watch": "webpack --progress --watch",
    "version": "json -f package.json -I -e \"this.repository.sha = '$(git log -n1 --pretty=format:%H)'\""
  },
  "config": {
    "commitizen": {
      "path": "cz-conventional-changelog"
    }
  },
  "tap": {
    "branches": 60,
    "functions": 70,
    "lines": 70,
    "statements": 70
  },
  "dependencies": {
    "@tensorflow-models/hand-pose-detection": "^2.0.1",
    "@tensorflow/tfjs-backend-webgl": "^4.22.0",
    "@tensorflow/tfjs-converter": "^4.22.0",
    "@tensorflow/tfjs-core": "^4.22.0",
    "@vernier/godirect": "^1.5.0",
    "arraybuffer-loader": "^1.0.6",
    "atob": "^2.1.2",
    "btoa": "^1.2.1",
    "canvas-toBlob": "^1.0.0",
    "decode-html": "^2.0.0",
    "diff-match-patch": "^1.0.4",
    "face-api.js": "^0.22.2",
    "format-message": "^6.2.1",
    "htmlparser2": "^3.10.0",
    "immutable": "^3.8.1",
    "jszip": "^3.1.5",
    "minilog": "^3.1.0",
    "racero-audio": "file:../racero-audio",
    "racero-boards": "file:../racero-boards",
    "scratch-parser": "^5.1.1",
    "scratch-render": "^1.0.13",
    "scratch-sb1-converter": "^1.0.0",
    "scratch-storage": "^2.3.5",
    "scratch-svg-renderer": "0.2.0-prerelease.20210727023023",
    "scratch-translate-extension-languages": "^1.0.0",
    "text-encoding": "^0.7.0",
    "uuid": "^8.3.2",
    "web-worker": "^1.3.0"
  },
  "devDependencies": {
    "adm-zip": "0.4.11",
    "callsite": "1.0.0",
    "copy-webpack-plugin": "4.6.0",
    "docdash": "1.2.0",
    "esbuild-loader": "^4.4.3",
    "eslint": "8.57.0",
    "eslint-config-scratch": "9.0.8",
    "expose-loader": "1.0.3",
    "file-loader": "6.2.0",
    "format-message-cli": "6.2.4",
    "in-publish": "2.0.1",
    "js-md5": "0.7.3",
    "jsdoc": "3.6.11",
    "json": "^9.0.4",
    "lodash.defaultsdeep": "4.6.1",
    "pngjs": "3.4.0",
    "racero-blocks": "../racero-blocks",
    "racero-l10n": "file:../racero-l10n",
    "scratch-render-fonts": "1.0.17",
    "scratch-semantic-release-config": "1.0.14",
    "script-loader": "0.7.2",
    "semantic-release": "19.0.5",
    "stats.js": "0.17.0",
    "tap": "16.3.10",
    "webpack": "5.90.3",
    "webpack-cli": "4.10.0",
    "webpack-dev-server": "3.11.3"
  }
}
